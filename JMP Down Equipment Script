//Number rows by tool ID
dt_down << New Column("Number", numeric, character, formula(Col Cumulative Sum(1, :Tool_ID)));
//Filter by row number to get the 3 most likely comments
dt_down << Select Where(:Number > 3);
dt_down << delete rows();

col_run = dt_down << Get Rows Where(:VG1 == "RUN");
col_idle = dt_down << Get Rows Where(:VG1 == "IDLE");
col_umaint = dt_down << Get Rows Where(:VG1 == "UMAINT");
col_eng = dt_down << Get Rows Where(:VG1 == "ENG");
col_smaint = dt_down << Get Rows Where(:VG1 == "SMAINT");
col_qual = dt_down << Get Rows Where(:VG1 == "QUAL");

For Each Row(
	If(:VG1 == "RUN",
	   :Tool_ID << Color Cells( "green", col_run );
	   :Tool_ID << Color Cells( "green", col_idle );
	   :Tool_ID << Color Cells( "red", col_umaint );
	   :Tool_ID << Color Cells( "blue", col_eng );
	   :Tool_ID << Color Cells( "red", col_smaint );
	   :Tool_ID << Color Cells( "yellow", col_qual )));
